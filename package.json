{
  "name": "Surfingkeys",
  "version": "1.19.1",
  "description": "Map your keys for web surfing, expand your browser with javascript and keyboard.",
  "main": "background.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "clean": "rm -rf dist/*",
    "build:doc": "documentation build src/content_scripts/common/api.js src/content_scripts/common/normal.js src/content_scripts/common/clipboard.js src/content_scripts/common/hints.js src/content_scripts/common/visual.js src/content_scripts/front.js src/user_scripts/index.js -f md -o docs/api.md",
    "build:dev": "webpack --mode=development --config ./config/webpack.config.js",
    "build:prod": "webpack --mode=production --config ./config/webpack.config.js",
    "build:testdata": "webpack --mode=production --config ./config/webpack.test.config.js",
    "build": "npm-run-all clean test build:doc build:prod",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brookhong/Surfingkeys.git"
  },
  "author": "brook hong",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brookhong/Surfingkeys/issues"
  },
  "homepage": "https://github.com/brookhong/Surfingkeys#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.28.3",
    "@types/events": "^3.0.3",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/lodash": "^4.17.25",
    "@types/offscreencanvas": "^2019.7.3",
    "babel-plugin-module-resolver": "^5.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "documentation": "^14.0.3",
    "file-loader": "^6.2.0",
    "filemanager-webpack-plugin": "^10.0.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-image-snapshot": "^6.5.2",
    "npm-run-all": "^4.1.5",
    "puppeteer": "^25.7.0",
    "strict-event-emitter-types": "^2.0.0",
    "string-replace-loader": "^3.3.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@pixi/app": "^7.4.0",
    "@pixi/constants": "^7.4.0",
    "@pixi/core": "^7.4.0",
    "@pixi/display": "^7.4.0",
    "@pixi/extensions": "^7.4.0",
    "@pixi/graphics": "^7.4.0",
    "@pixi/math": "^7.4.0",
    "@pixi/runner": "^7.4.0",
    "@pixi/settings": "^7.4.0",
    "@pixi/sprite": "^7.4.0",
    "@pixi/ticker": "^7.4.0",
    "@pixi/unsafe-eval": "^7.4.0",
    "@pixi/utils": "^7.4.0",
    "ace-builds": "^1.44.0",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.13",
    "js-base64": "^3.9.2",
    "lodash": "^4.18.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "4.8.69"
  }
}
